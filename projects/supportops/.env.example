# Copy values into your process environment; this file is NOT auto-loaded.
SUPPORTOPS_DB=data/supportops.sqlite3
# Offline evidence retrieval is the default. Local models need only URL and model.
# Remote generation only permits explicit OpenRouter :free models and requires a key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
# Required for non-loopback access. Send Authorization: Bearer <token>.
SUPPORTOPS_ACCESS_TOKEN=
