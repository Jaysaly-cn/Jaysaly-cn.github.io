    {
      "id": "tomato-eggs",
      "name": "西红柿炒鸡蛋",
      "minutes": 15,
      "tools": [
        "炒锅"
      ],
      "portion": "原方 1 份约供 1 人",
      "description": "酸甜多汁的番茄配嫩鸡蛋，简单下饭的家常炒菜。",
      "ingredients": [
        {
          "name": "西红柿",
          "quantity": 1,
          "unit": "个",
          "maximum": null,
          "optional": false,
          "offset": 0,
